# Server port
API=3000

# JWT secret (required — server will not start without this)
JWT_SECRET=change-me-to-a-random-secret

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database config (SQLite)
# DB_HOST is used as Sequelize dialect
# DB_PORT is used as Sequelize storage path
DB_HOST=sqlite
DB_PORT=./database.sqlite
